NCBI_EMAIL=
NCBI_API_KEY=
PUBMED_TIMEOUT_SECONDS=15
PUBMED_MAX_RETRIES=2
PUBMED_RETRY_BACKOFF_SECONDS=0.25
PUBMED_RETRY_MAX_BACKOFF_SECONDS=2
PUBMED_CACHE_ENABLED=1
PUBMED_CACHE_TTL_SECONDS=300
PUBMED_CACHE_MAX_ENTRIES=128
PUBMED_HYBRID_CACHE_ENABLED=1
PUBMED_HYBRID_CACHE_TTL_SECONDS=300
PUBMED_HYBRID_CACHE_MAX_ENTRIES=128
EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2
CROSS_ENCODER_MODEL=D:\ml-cache\models\ms-marco-MiniLM-L6-v2
# Local path only; API requests never auto-download this model.
# Optional PostgreSQL + pgvector persistence (stage 3)
VECTOR_DATABASE_URL=postgresql://search:search@localhost:5433/search
VECTOR_CORPUS_VERSION=pubmed-snapshot-v1
# Local Ollama (OpenAI-compatible API). The key is required by clients but ignored locally.
LLM_BASE_URL=http://127.0.0.1:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=qwen2.5:3b
LLM_TIMEOUT_SECONDS=180
LLM_MAX_RETRIES=2
LLM_MAX_OUTPUT_TOKENS=256
LLM_CACHE_ENABLED=1
LLM_CACHE_DIR=D:\Codex\medical-evidence-agent\python_proj\search_api\artifacts\llm_cache
# Optional non-local provider pricing, USD per one million tokens.
LLM_INPUT_COST_PER_MILLION=0
LLM_OUTPUT_COST_PER_MILLION=0
